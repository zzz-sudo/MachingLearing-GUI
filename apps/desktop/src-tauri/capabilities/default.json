{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop window capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "process:allow-restart",
    "shell:allow-kill",
    "updater:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/task-service",
          "sidecar": true,
          "args": ["--host", "127.0.0.1", "--port", "8765"]
        }
      ]
    }
  ]
}
